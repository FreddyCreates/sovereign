  triggerEmergencyBroadcast: (worldSignal: text) -> (EmergencyBroadcast);
  triggerSandboxCycle: (orgId: SandboxOrganismId) -> (SandboxOrganismState);
  /// Undeploy a SKAI organism — deactivates its Colonel kernel, resets deployedAtBeat.
  /// Returns true on success, false if skaiId not found.
  undeploySKAI: (skaiId: nat) -> (bool);
  /// Uninstall a SKAI from the persistent install registry and toolbar.
  uninstallSkai: (skaiName: text) -> (variant {
                                        Err: text;
                                        Ok;
                                      });
  /// Manual founder unlock — requires sovereign keyword "ALFREDO_MEDINA_SOVEREIGN_UNLOCK".
  unlockSettings: (keyword: text) -> (bool);
  /// Unlock a world parameter — only succeeds if no active anomalies for its domain.
  /// Returns true if unlocked, false if still locked (active anomalies present).
  unlockWorldParam: (name: text) -> (bool);
  updateActorFilmography: (actorId: nat, filmTitle: text) -> (bool);
  updateActorSceneMemory: (actorId: nat, scene: SceneMemoryEntry) -> ();
  updateArtifactReviewStatus: (artifactId: text, status: ReviewStatus,
   comment: text) -> (ArtifactReview);
  updateInterOrganismState: (organism: text, orgState: text) -> ();
  /// Update the lastAppliedBeat for a law record by its numeric ID.
  /// Distinct from VaultMixin.injectLawToDoctrineState (which uses Text lawId).
  updateLawAppliedBeat: (lawId: nat) -> (variant {
                                           err: text;
                                           ok: bool;
                                         });
  updatePipelineStage: (stage: text, progress: nat) -> ();
  updateRelationshipAfterProduction: (actorA: text, actorB: text,
   doctrineAlignmentDiff: float64) -> ();
  updateSandboxLedgerInputs: (commercialCount: nat, filmCount: nat,
   beatCount: nat) -> ();
  /// Update SETTINGS_PROTOCOL — only allowed when infrastructure is not locked.
  updateSettingsProtocol: (heartbeatOverrideMs: opt nat, sensorSensitivity:
   opt float64, dispatchSpeed: opt float64, doctrineRefreshRate:
   opt float64) -> (bool);
  validateArtifactDoctrine: (artifactId: text, content: text, archType:
   text) -> (DoctrineValidationResult__1);
  /// GAP_9: Validate director input against active doctrine laws.
  validateDirectorInput: (input: text, activeLawIds: vec nat) ->
   (DirectorValidationResult) query;
  validateDoctrineAlignment: (prompt: text) ->
   (DoctrineValidationResult) query;
  validateFrameCount: (frameCount: nat, format: ProductionFormat) ->
   (bool) query;
  verifyAttributionRights: (filmId: text) ->
   (opt record {
          isVerified: bool;
          law: text;
          note: text;
          producer: text;
        }) query;
  writeSharedSceneDelta: (sourceActorId: text, targetActorId: text,
   doctrineAlignment: float64, emotionalIntensity: float64) -> ();
