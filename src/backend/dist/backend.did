  novaGetTriHeart: () ->
   (record {
      beat: nat;
      coreVelocity: float64;
      globalCoherence: float64;
      globalVelocity: float64;
      isAligned: bool;
      labVelocity: float64;
      productionVelocity: float64;
      torusTriggered: bool;
      totalRealignments: nat;
    }) query;
