  novaRecordGateViolation: (agentId: text) -> (record {
                                                  agentId: text;
                                                  ok: bool;
                                                });
  /// DUTY GATE — register a new sovereign agent in the duty gate system.
  novaRegisterAgent: (agentId: text, agentName: text) -> (DutyGateResult);
  /// NEVER decrements. Called on every artifact seal event.
  onArtifactSealed: () -> ();
