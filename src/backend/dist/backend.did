service : {
  activateSurgeAhead: () -> (bool);
  addTrendingContent: (signal: text, format: ContentFormat) ->
   (TrendingContentItem);
  advanceFilmBeat: (stage: text) -> (BeatAdvanceResult);
  /// TRANSLATION_ENGINE: one function, one loop over 35 law records.
  /// Applies each active law's parameters as doctrine constraints.
  /// Returns the count of laws applied this call.
  applyAllLaws: () -> (nat);
  applyLawToApplication: (lawId: nat, appId: text) -> (AppRecord);
  /// Attempt to mutate a world parameter value.
  /// Returns #Err if parameter is locked.
  attemptWorldParamMutation: (name: text, newValue: float64) ->
   (variant {
      Err: text;
      Ok;
    });
