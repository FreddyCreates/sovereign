  /// Returns the install snapshot with toolbar_button_id ready for the frontend toolbar.
  /// TAFT-governed: if the SKAI goes dormant, auto-restart fires on next heartbeat.
  installSkai: (skaiName: text) ->
   (variant {
      Err: text;
      Ok: SkaiInstallSnapshot;
    });
  isPresenceGateOpen: () -> (bool) query;
  /// List all registered model names.
  listModels: () -> (vec text) query;
  listProductionWorlds: () -> (vec text) query;
  /// Lock a world parameter (e.g. "phi_coupling") with a reason.
  /// Auto-unlocks after 10 beats if anomaly queue is empty.
  lockWorldParam: (name: text, reason: text) -> ();
  /// Log and process an IoT signal — parsed through civilizationCoupling immediately.
  logIoTSignal: (signal: text) -> ();
  mergeProductionWorlds: (worldId1: text, worldId2: text) -> (opt text);
  /// Merge two world instances. Composes their artifact counts and coherence.
  /// Returns the merged world's ID, or error if either world is not found.
  mergeWorldInstances: (sourceId: WorldInstanceId, targetId:
   WorldInstanceId) -> (variant {
                          err: text;
                          ok: WorldInstanceId;
                        });
  /// NOVA PROTOCOL — begin execution phase for an agent (Deployed → Executing).
  /// Gate-locks the agent until the job is complete.
  novaBeginExecution: (agentId: text) -> (DutyGateResult);
  /// NOVA CHARTER — check charter compliance against live organism state.
  novaCheckCharter: () -> (CharterCheckResult) query;
  /// NOVA PROTOCOL — complete a job (Executing → Resting, committed to Memory Vault).
  novaCompleteJob: (agentId: text) -> (DutyGateResult);
  /// NOVA PROTOCOL — deploy an agent to a job (Resting → Deployed).
  novaDeployAgent: (agentId: text, jobId: text, objective: text) -> (DutyGateResult);
  /// DUTY GATE — get all agents and current duty gate summary.
  novaDutyGateState: () ->
   (record {
      activeJobs: nat;
      beat: nat;
      globalDutyScore: float64;
      totalAgents: nat;
      totalCycles: nat;
      totalViolations: nat;
    }) query;
  /// NOVA PROTOCOL — full system snapshot (TriHeart + DutyGate + Charter in one call).
  novaGetFullState: () ->
   (record {
      activeJobs: nat;
      architectSignature: text;
      attribution: text;
      beat: nat;
      coherenceVelocity: float64;
      globalCharterCoherence: float64;
      isLive: bool;
      schumannAnchor: float64;
      totalAgents: nat;
      totalCharterViolations: nat;
      totalDutyCycles: nat;
      totalGateViolations: nat;
      totalRealignments: nat;
      totalArticles: nat;
      torusTriggered: bool;
      triHeartAligned: bool;
      triHeartVelocity: float64;
      documentId: text;
      version: nat;
    }) query;
  /// NOVA CHARTER — get a specific article by ID (e.g. "NOVA-I-01").
  novaGetArticle: (articleId: text) -> (opt CharterArticle) query;
  /// NOVA PROTOCOL — get a specific agent's current duty record.
  novaGetAgent: (agentId: text) -> (opt AgentDutyRecord) query;
  /// NOVA CHARTER — full charter state snapshot (all 15 articles + metadata).
  novaGetCharter: () -> (NovaCharterState) query;
