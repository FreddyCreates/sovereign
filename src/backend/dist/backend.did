   FilmRecord) ->
   (record {
      adreResult: ADRECycleResult;
      qualityScore: QualityScore;
      sealResult: ArtifactSealResult;
    });
  sealFilmWithFullMetadata: (input: FilmMetadataInput) -> (GeneratedFilm);
  sealGeneratedFilm: (input: GeneratedFilmInput) -> (GeneratedFilm);
