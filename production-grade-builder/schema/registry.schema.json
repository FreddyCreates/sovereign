{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Production-Grade Packet Registry",
  "description": "Schema for deliverable profiles in the Sovereign production-grade builder",
  "type": "object",
  "required": ["name", "type", "version", "author", "created", "surfaces"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable packet name"
    },
    "type": {
      "type": "string",
      "enum": [
        "static-app",
        "python-service",
        "node-service",
        "benchmark-engine",
        "local-api",
        "ci-workflow",
        "dataset",
        "manifest",
        "proof-pack",
        "research-packet",
        "dashboard",
        "docs",
        "deploy-scaffold",
        "repo-surface"
      ],
      "description": "Deliverable surface type"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "author": {
      "type": "string",
      "description": "Attribution (immutable after genesis)"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "surfaces": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Surface types this packet covers"
    },
    "entry_point": {
      "type": "string",
      "description": "Main entry file for the deliverable"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "External dependencies (packages, services)"
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Last computed quality gate score"
    },
    "checksum": {
      "type": "string",
      "description": "SHA-256 checksum of release artifact"
    }
  },
  "additionalProperties": false
}
