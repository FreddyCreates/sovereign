#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                        SOVEREIGN MOC COMPILER HELPER                       ║
# ║           Native Motoko Compilation & Validation for SOVEREIGN             ║
# ║                                                                            ║
# ║  Usage:                                                                    ║
# ║    ./moc check       - Type-check all Motoko files                         ║
# ║    ./moc check:fix   - Type-check with auto-fix                            ║
# ║    ./moc build       - Build the canister                                  ║
# ║    ./moc test        - Run mops test                                       ║
# ║    ./moc deps        - Install mops dependencies                           ║
# ║    ./moc watch       - Watch mode for continuous checking                  ║
# ║    ./moc clean       - Clean build artifacts                               ║
# ║    ./moc help        - Show this help                                      ║
# ║                                                                            ║
# ║  Attribution: Alfredo Medina Hernandez — immutable                         ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Constants
BACKEND_DIR="src/backend"
FOUNDER="Alfredo Medina Hernandez"
VERSION="2.0.0"

# Helper functions
print_header() {
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${BOLD}SOVEREIGN MOC COMPILER${NC} v${VERSION}                             ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  Attribution: ${FOUNDER}                   ${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Check if mops is installed
check_mops() {
    if ! command -v mops &> /dev/null; then
        print_error "mops is not installed. Install with: npm i -g ic-mops"
        exit 1
    fi
}

# Change to backend directory
cd_backend() {
    if [ ! -d "$BACKEND_DIR" ]; then
        print_error "Backend directory not found: $BACKEND_DIR"
        exit 1
    fi
    cd "$BACKEND_DIR"
}

# Commands
cmd_check() {
    print_header
    print_info "Type-checking Motoko files..."
    check_mops
    cd_backend
    
    if mops check; then
        print_success "Type-check passed!"
    else
        print_error "Type-check failed"
        exit 1
    fi
}

cmd_check_fix() {
    print_header
    print_info "Type-checking Motoko files with auto-fix..."
    print_warning "Note: --fix may corrupt files with special characters. Review changes."
    check_mops
    cd_backend
    
    if mops check --fix; then
        print_success "Type-check with fix completed!"
    else
        print_error "Type-check failed"
        exit 1
    fi
}

cmd_build() {
    print_header
    print_info "Building SOVEREIGN canister..."
    check_mops
    cd_backend
    
    if mops build; then
        print_success "Build completed!"
    else
        print_error "Build failed"
        exit 1
    fi
}

cmd_test() {
    print_header
    print_info "Running Motoko tests..."
    check_mops
    cd_backend
    
    if mops test; then
        print_success "All tests passed!"
    else
        print_error "Tests failed"
        exit 1
    fi
}

cmd_deps() {
    print_header
    print_info "Installing mops dependencies..."
    check_mops
    cd_backend
    
    if mops install; then
        print_success "Dependencies installed!"
    else
        print_error "Dependency installation failed"
        exit 1
    fi
}

cmd_watch() {
    print_header
    print_info "Starting watch mode for continuous type-checking..."
    print_info "Press Ctrl+C to stop"
    check_mops
    cd_backend
    
    while true; do
        clear
        print_header
        echo -e "${YELLOW}[$(date '+%H:%M:%S')]${NC} Checking..."
        if mops check 2>&1; then
            print_success "Type-check passed!"
        else
            print_error "Type-check failed"
        fi
        echo ""
        echo -e "${BLUE}Waiting for changes... (Ctrl+C to stop)${NC}"
        sleep 5
    done
}

cmd_clean() {
    print_header
    print_info "Cleaning build artifacts..."
    cd_backend
    
    # Clean common build directories
    rm -rf .dfx 2>/dev/null || true
    rm -rf .mops 2>/dev/null || true
    rm -rf dist 2>/dev/null || true
    
    print_success "Build artifacts cleaned!"
    print_info "Run './moc deps' to reinstall dependencies"
}

cmd_help() {
    print_header
    echo -e "${BOLD}Usage:${NC} ./moc <command>"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo -e "  ${GREEN}check${NC}       Type-check all Motoko files"
    echo -e "  ${GREEN}check:fix${NC}   Type-check with auto-fix (use with caution)"
    echo -e "  ${GREEN}build${NC}       Build the canister"
    echo -e "  ${GREEN}test${NC}        Run mops tests"
    echo -e "  ${GREEN}deps${NC}        Install mops dependencies"
    echo -e "  ${GREEN}watch${NC}       Watch mode for continuous checking"
    echo -e "  ${GREEN}clean${NC}       Clean build artifacts"
    echo -e "  ${GREEN}help${NC}        Show this help"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  ./moc check        # Quick type-check"
    echo "  ./moc build        # Build for deployment"
    echo "  ./moc watch        # Continuous development mode"
    echo ""
    echo -e "${BOLD}System Info:${NC}"
    echo -e "  Backend Dir: ${CYAN}$BACKEND_DIR${NC}"
    if command -v mops &> /dev/null; then
        echo -e "  mops: ${GREEN}installed${NC}"
    else
        echo -e "  mops: ${RED}not installed${NC} (npm i -g ic-mops)"
    fi
}

# Main entry point
main() {
    case "${1:-help}" in
        check)
            cmd_check
            ;;
        check:fix)
            cmd_check_fix
            ;;
        build)
            cmd_build
            ;;
        test)
            cmd_test
            ;;
        deps)
            cmd_deps
            ;;
        watch)
            cmd_watch
            ;;
        clean)
            cmd_clean
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            print_error "Unknown command: $1"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
